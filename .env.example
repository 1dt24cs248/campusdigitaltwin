# Optional OpenAI-compatible language model. The dashboard works without these values.
ECOTWIN_LLM_API_KEY=
ECOTWIN_LLM_BASE_URL=https://api.openai.com/v1
ECOTWIN_LLM_MODEL=gpt-4o-mini
ECOTWIN_LLM_TIMEOUT_SECONDS=20

# Frontend API URL is a Vercel build-time setting (never put secrets in VITE_ variables):
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Backend CORS allowlist (comma-separated origins; no trailing slash):
ECOTWIN_CORS_ORIGINS=https://campusdigitaltwin.vercel.app,http://localhost:5173,http://127.0.0.1:5173
